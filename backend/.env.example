# MIRROR AI Backend - Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mirror_ai

# ── GitHub ──
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ── Gemini LLM ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Application ──
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-string

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000"]

# ── Rate Limiting ──
RATE_LIMIT_ANALYZE_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=60

# ── Analysis Limits ──
MAX_REPOS_PER_USER=20
MAX_COMMITS_PER_REPO=500
MAX_FILES_PER_REPO=200
MAX_FILE_SIZE_BYTES=524288

# ── Caching ──
GITHUB_CACHE_TTL_HOURS=24
